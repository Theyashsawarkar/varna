# ~/.zshrc sources this after ~/.p10k.zsh: the prompt's colours.
typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND='{{accent2}}'
typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND='{{error_prompt|red}}'
typeset -g POWERLEVEL9K_DIR_FOREGROUND='{{accent2}}'
typeset -g POWERLEVEL9K_DIR_SHORTENED_FOREGROUND='{{accent2}}'
typeset -g POWERLEVEL9K_DIR_ANCHOR_FOREGROUND='{{accent2}}'
typeset -g POWERLEVEL9K_VCS_CLEAN_FOREGROUND='{{clean|green}}'
typeset -g POWERLEVEL9K_VCS_UNTRACKED_FOREGROUND='{{untracked|overlay2}}'
typeset -g POWERLEVEL9K_VCS_MODIFIED_FOREGROUND='{{modified|yellow}}'
typeset -g POWERLEVEL9K_STATUS_OK_FOREGROUND='{{clean|green}}'
typeset -g POWERLEVEL9K_STATUS_OK_PIPE_FOREGROUND='{{clean|green}}'
typeset -g POWERLEVEL9K_STATUS_ERROR_FOREGROUND='{{error_prompt|red}}'
typeset -g POWERLEVEL9K_STATUS_ERROR_SIGNAL_FOREGROUND='{{error_prompt|red}}'
typeset -g POWERLEVEL9K_STATUS_ERROR_PIPE_FOREGROUND='{{error_prompt|red}}'
typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_FOREGROUND='{{modified|yellow}}'
typeset -g POWERLEVEL9K_BACKGROUND_JOBS_FOREGROUND='{{jobs|blue}}'
# read by the git formatter in ~/.p10k.zsh
typeset -g VARNA_GIT_CLEAN='{{clean|green}}' VARNA_GIT_MODIFIED='{{modified|yellow}}'
typeset -g VARNA_GIT_UNTRACKED='{{untracked|overlay2}}' VARNA_GIT_CONFLICTED='{{error_prompt|red}}'
