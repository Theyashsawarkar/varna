# zathura's colours (its zathurarc: include ../../.local/state/varna/zathurarc).
# recolor maps the page's white to the theme's background and its black to
# the text colour, keeping hues (photos, charts): Ctrl+r toggles it.
set default-bg                "{{base}}"
set default-fg                "{{text}}"
set statusbar-bg              "{{crust}}"
set statusbar-fg              "{{subtext1}}"
set inputbar-bg               "{{crust}}"
set inputbar-fg               "{{text}}"
set notification-bg           "{{crust}}"
set notification-fg           "{{text}}"
set notification-error-bg     "{{crust}}"
set notification-error-fg     "{{urgent}}"
set notification-warning-bg   "{{crust}}"
set notification-warning-fg   "{{peach}}"
set completion-bg             "{{mantle}}"
set completion-fg             "{{text}}"
set completion-group-bg       "{{crust}}"
set completion-group-fg       "{{accent}}"
set completion-highlight-bg   "{{surface0}}"
set completion-highlight-fg   "{{accent}}"
set index-bg                  "{{base}}"
set index-fg                  "{{text}}"
set index-active-bg           "{{surface0}}"
set index-active-fg           "{{accent}}"
set highlight-color           "{{accent:rgba=0.35}}"
set highlight-fg              "{{base}}"
set highlight-active-color    "{{peach:rgba=0.5}}"
set recolor-lightcolor        "{{base}}"
set recolor-darkcolor         "{{text}}"
set recolor                   "true"
set recolor-keephue           "true"
set font                      "{{font}} 11"
