# btop theme (the tmux popup runs: btop -c ~/.local/state/varna/btop.conf)
theme[main_bg]=""
theme[main_fg]="{{text}}"
theme[title]="{{text}}"
theme[hi_fg]="{{accent}}"
theme[selected_bg]="{{surface0}}"
theme[selected_fg]="{{accent}}"
theme[inactive_fg]="{{overlay1}}"
theme[graph_text]="{{subtext0}}"
theme[meter_bg]="{{surface1}}"
theme[proc_misc]="{{accent2}}"
theme[cpu_box]="{{frame}}"
theme[mem_box]="{{frame}}"
theme[net_box]="{{frame}}"
theme[proc_box]="{{frame}}"
theme[div_line]="{{frame}}"
theme[temp_start]="{{green}}"
theme[temp_mid]="{{yellow}}"
theme[temp_end]="{{red}}"
theme[cpu_start]="{{teal}}"
theme[cpu_mid]="{{accent2}}"
theme[cpu_end]="{{accent}}"
theme[free_start]="{{green}}"
theme[free_mid]="{{green}}"
theme[free_end]="{{teal}}"
theme[cached_start]="{{blue}}"
theme[cached_mid]="{{blue}}"
theme[cached_end]="{{lavender}}"
theme[available_start]="{{peach}}"
theme[available_mid]="{{peach}}"
theme[available_end]="{{yellow}}"
theme[used_start]="{{red}}"
theme[used_mid]="{{red}}"
theme[used_end]="{{maroon}}"
theme[download_start]="{{blue}}"
theme[download_mid]="{{accent2}}"
theme[download_end]="{{accent}}"
theme[upload_start]="{{green}}"
theme[upload_mid]="{{teal}}"
theme[upload_end]="{{accent2}}"
theme[process_start]="{{accent2}}"
theme[process_mid]="{{accent}}"
theme[process_end]="{{red}}"
